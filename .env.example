# Root environment file - Copy to .env
# Individual services have their own .env files in their directories

# OpenAI API Key (required for agent)
OPENAI_API_KEY=sk-your-key-here

# Anthropic API Key (optional alternative)
ANTHROPIC_API_KEY=your-key-here

# Frontend URL
FRONTEND_URL=http://localhost:5173
# Password-recovery email. Blank SMTP_HOST/SMTP_FROM disables email recovery.
# Set FRONTEND_URL to your trusted HTTPS frontend origin in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional real support address; only then does a contact link appear.
SUPPORT_EMAIL=
# Development-only local SMTP sinks; never permits plaintext production email.
SMTP_ALLOW_INSECURE_LOCAL=false
# Keep empty for direct backend access; set only to actual trusted proxy IPs/CIDRs.
TRUST_PROXY=

# Backend URL
BACKEND_URL=http://localhost:5000

# Agent URL
AGENT_URL=http://localhost:8000

# Shared private key for backend-to-worker previews and ZIP uploads. Generate a random value.
PREVIEW_API_SECRET=
# Remote deployments need a dedicated, same-site HTTPS preview origin.
PREVIEW_PUBLIC_URL=

# Pro is $199 USD one-time. Keys must belong to the same Stripe account/mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
