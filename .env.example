# Docker Compose configuration. Private values belong only in the ignored root .env.
# Run node scripts/prepare-env.mjs to generate JWT_SECRET and PREVIEW_API_SECRET.
NODE_ENV=development
JWT_SECRET=
PREVIEW_API_SECRET=

# Local database defaults only. Use a unique password before first production setup.
# Changing DB_PASSWORD does not change the password in an existing PostgreSQL volume.
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agentic_converter

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000
# A dedicated same-site HTTPS preview origin is required for remote deployment.
PREVIEW_PUBLIC_URL=
APP_DNS_PRIMARY=1.1.1.1
APP_DNS_SECONDARY=8.8.8.8

# Configure at least one provider. Model defaults are defined in worker settings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-128k
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPEN_SOURCE_API_KEY=
OPEN_SOURCE_MODEL=
OPEN_SOURCE_BASE_URL=

# Optional tracing. Leave disabled unless you intend to send traces to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=STATIC-TO-DYNAMIC-WEBSITE-CONVERTER

# Pro: $199 USD one-time. All Stripe keys must belong to the same account and mode.
# VITE_STRIPE_PUBLISHABLE_KEY is intentionally public; secret keys must never be VITE_*.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Password recovery. Empty SMTP_HOST/SMTP_FROM disables email recovery.
# Production requires an HTTPS FRONTEND_URL and a verified sending address.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPPORT_EMAIL=
SMTP_ALLOW_INSECURE_LOCAL=false
# Only for optional Mailtrap account-management/testing tooling, never the frontend.
MAILTRAP_API_TOKEN=
MAILTRAP_ACCOUNT_ID=
MAILTRAP_INBOX_ID=
TRUST_PROXY=

# Server-only HTTPS deployment. Do not change these to expose the local demo.
# Example: converter.your-domain.example; preview uses preview.<PUBLIC_APP_HOST>.
PUBLIC_APP_HOST=
TLS_CONTACT_EMAIL=

# Optional platform administrator. Not the generated website's admin account.
# Set a unique password of at least 12 characters; run backend npm run seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# Optional API smoke-check account. Never hardcode these in test scripts.
E2E_ACCOUNT_EMAIL=
E2E_ACCOUNT_PASSWORD=
