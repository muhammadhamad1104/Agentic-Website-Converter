# API
API_HOST=0.0.0.0
API_PORT=8000

# LLM
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=your-key-here
DEFAULT_LLM_MODEL=gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/agentic_converter

# Redis
REDIS_URL=redis://localhost:6379

# Storage
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
AWS_S3_BUCKET=agentic-converter-assets
AWS_REGION=us-east-1

# Engine
JOB_STORE_PATH=data/conversion_jobs.db
CRAWL_DEPTH_LIMIT_DEFAULT=3
CRAWL_MAX_PAGES_DEFAULT=0
CRAWL_MAX_ASSETS_DEFAULT=0
CRAWL_SAME_DOMAIN_ONLY_DEFAULT=true
CRAWL_FOLLOW_ASSET_DOMAINS_DEFAULT=true
CRAWL_REQUEST_TIMEOUT_SECONDS=20
CRAWL_REQUEST_RETRIES=3
CRAWL_VERIFY_TLS_DEFAULT=true
CRAWL_ENFORCE_STATIC_SOURCE_DEFAULT=true
CRAWL_RESUME_FROM_CHECKPOINT_DEFAULT=true
CRAWL_INCLUDE_SITEMAP_SEEDS_DEFAULT=true
CRAWL_RENDER_JS_DEFAULT=true
CRAWL_RENDER_WAIT_SECONDS=2
CRAWL_RENDER_HEADLESS=true

# Quality gates
QUALITY_EXTRACTION_MIN_NON_EMPTY_PAGE_RATIO=0.5
QUALITY_EXTRACTION_MIN_AVG_TEXT_LENGTH=8
QUALITY_EXTRACTION_FAIL_ON_LOW_TEXT_DENSITY=false
QUALITY_EXTRACTION_MAX_BLOCKS=60
QUALITY_EXTRACTION_MAX_BLOCK_LENGTH=1200
QUALITY_EXTRACTION_MIN_BLOCK_CHAR_LENGTH=20
QUALITY_INFER_USE_EXTRACTED_BLOCKS=true
QUALITY_INFER_MAX_EVIDENCE_SLICES=8
QUALITY_SCAFFOLD_MIN_DIR_COUNT=10
QUALITY_SCAFFOLD_MIN_FILE_COUNT=10
QUALITY_GENERATION_REQUIRE_SCHEMA_QUALITY_GATE=true
QUALITY_GENERATION_REQUIRE_SCAFFOLD_QUALITY_GATE=true
QUALITY_SCHEMA_MAX_GENERIC_ENTITY_RATIO=0.55
QUALITY_SCHEMA_MIN_ENTITY_CONFIDENCE=0.35
QUALITY_VALIDATION_MIN_SEMANTIC_RATIO=0.45
QUALITY_VALIDATION_MIN_READINESS_SCORE=80
QUALITY_VALIDATION_REQUIRE_ENTITY_ENDPOINT_ALIGNMENT=true
QUALITY_EXPORT_REQUIRE_DEPLOYMENT_READY=true
QUALITY_EXPORT_VERIFY_PACKAGE_LAYOUT=true
QUALITY_EXPORT_MIN_ZIP_BYTES=512
EXPORT_COPY_TO_DOWNLOADS=true
EXPORT_DOWNLOADS_DIR=
QUALITY_PROFILE=prod
QUALITY_USE_PROFILE_PRESETS=true

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=STATIC-TO-DYNAMIC-WEBSITE-CONVERTER
