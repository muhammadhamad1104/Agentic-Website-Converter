# ==================================
# Backend Environment Configuration
# ==================================

# Server
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Database (PostgreSQL with Connection Pool)
DATABASE_URL=postgresql://user:password@localhost:5432/agentic_converter
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_SSL=false

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Analytics (Privacy-First with HMAC)
ANALYTICS_SECRET=your-hmac-secret-for-ip-hashing

# Email
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPPORT_EMAIL=
SMTP_ALLOW_INSECURE_LOCAL=false
TRUST_PROXY=

# AWS S3
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
AWS_S3_BUCKET=agentic-converter-assets
AWS_REGION=us-east-1

# Python Agent
AGENT_API_URL=http://localhost:8000
AGENT_API_KEY=your-agent-api-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# CORS
CORS_ORIGIN=http://localhost:3000

# Security
COOKIE_SECRET=your-cookie-secret-key
ARGON2_MEMORY_COST=65536

# Feature Flags
ENABLE_MFA=true
ENABLE_WEBHOOKS=true

PREVIEW_API_SECRET=
# Set the same random secret on the Python worker. Preview requires local Node/npm.
